ANTHROPIC_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
PORT=8787

# Use the same three names (not PORT) as Netlify environment variables.
# Site configuration → Environment variables. Never prefix them with VITE_.


# Riff Master multiplayer (browser-side). These two ARE meant to be public:
# the anon key joins Realtime rooms, and row-level security (no anon policies)
# keeps it out of the episodes/digests tables. Set them in Netlify too.
# Without them, rooms only link tabs in the same browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
